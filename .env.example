# Optional overrides for docker compose. Copy this file to .env and edit it.
# Every value below is already the default, so you only need .env to change one.

# Credentials for the local Postgres container (development only).
# Use letters and digits, or URL-encode special characters, because the
# password is also placed inside DATABASE_URL.
POSTGRES_USER=brightloop
POSTGRES_PASSWORD=brightloop
POSTGRES_DB=brightloop

# Host ports. Change one if something on your machine already uses it.
# 5433 (not 5432) avoids clashing with a Postgres installed directly on the machine.
POSTGRES_HOST_PORT=5433
API_PORT=8000
WEB_PORT=5173

# Secret that signs login tokens, at least 32 characters. Leave it unset for local
# development (a built-in development secret is used). Anywhere else, set a long
# random value, for example from: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
